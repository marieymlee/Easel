{
  "name": "@easel/design-system",
  "version": "0.1.0",
  "description": "Easel — a design system for art gallery and collection interfaces.",
  "type": "module",
  "license": "MIT",
  "author": "Marie",
  "repository": {
    "type": "git",
    "url": "https://github.com/marieymlee/Easel.git"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "art",
    "gallery"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/easel.umd.cjs",
  "module": "./dist/easel.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/easel.js",
      "require": "./dist/easel.umd.cjs"
    },
    "./styles.css": "./dist/easel.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0"
  }
}
